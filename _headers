# Crescita Counseling: Cloudflare Pages _headers
# CSS and JS links carry ?v=YYYYMMDD; bump it in every page when those files change.
# Cloudflare joins headers from every matching rule, so Cache-Control is set
# only on the asset folders (pages keep Cloudflare's default: always revalidate).

# Every response
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Static assets
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=2592000

/css/*
  Cache-Control: public, max-age=86400

/js/*
  Cache-Control: public, max-age=86400

# Special files
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=86400

# Internal working files: never index
/content/*
  X-Robots-Tag: noindex, nofollow

/scripts/*
  X-Robots-Tag: noindex, nofollow

/ops/*
  X-Robots-Tag: noindex, nofollow

/README.md
  X-Robots-Tag: noindex, nofollow
